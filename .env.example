# Next.js carga este archivo como referencia para .env.local.
# No se necesitan variables NEXT_PUBLIC_SUPABASE_*: el cliente Supabase es server-only.
# Overrides opcionales para E2E contra un servidor Next.js ya iniciado:
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_WEB_SERVER_COMMAND=corepack pnpm dev -- --hostname 127.0.0.1

# Supabase: solo servidor. Defina la URL y exactamente una de las dos claves.
# Nunca renombre estas variables a NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GAME_ROUND_SIZE=5
