{
  "schemaVersion": 1,
  "listVersion": "2026-08-01.1",
  "normalization": "trim+nfc+es-lowercase+exact-full-alias",
  "policy": {
    "match": "exact-full-alias",
    "partialMatches": false,
    "collapseInternalSpaces": false,
    "externalServices": false
  },
  "aliases": [
    "admin",
    "administrator",
    "administrador",
    "anonymous",
    "anonimo",
    "anónimo",
    "antidoto",
    "antídoto",
    "bot",
    "moderador",
    "moderator",
    "null",
    "owner",
    "root",
    "soporte",
    "staff",
    "system",
    "undefined",
    "unesco"
  ]
}
